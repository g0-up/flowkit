{
  "metamodel_version": 1,
  "trigger": {"event": "order.paid"},
  "steps": [
    {"id": "notify", "type": "action", "action": "send_email",
     "params": {"to": {"$expr": "event.email"}, "template": "order_paid", "vars": {"tracking": {"$expr": "facts.shipment.tracking"}}},
     "next": "ship"},
    {"id": "ship", "type": "action", "action": "create_shipment",
     "params": {"order_id": {"$expr": "event.order_id"}, "country": "VN"}, "next": "done"},
    {"id": "done", "type": "end", "name": "done"}
  ]
}
