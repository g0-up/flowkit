{
  "metamodel_version": 1,
  "trigger": {"event": "order.paid"},
  "steps": [
    {"id": "delivered", "type": "wait_for_event", "event": "shipment.delivered",
     "match": "event.customer_id != ''", "timeout": "7d", "on_timeout": "done", "next": "done"},
    {"id": "done", "type": "end", "name": "done"}
  ]
}
